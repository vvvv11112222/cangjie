# v0.6 configuration contract. No real credentials; implementations validate it at startup.
APP_ENV=development
API_LISTEN_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:8080
DATABASE_URL=
MEDIA_ROOT=./var/media
WORKER_API_BASE=http://127.0.0.1:8080/internal/v1
WORKER_ID=worker-01
WORKER_TOKEN=
WORKER_CAPABILITIES=probe,audio_analysis,video_analysis
WORKER_CONCURRENCY=1
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_REAPER_SECONDS=15
PROBE_TIMEOUT_SECONDS=1800
ASR_TIMEOUT_SECONDS=14400
VIDEO_TIMEOUT_SECONDS=3600
GO_STAGE_TIMEOUT_SECONDS=300
GOVERNANCE_LEASE_SECONDS=120
GOVERNANCE_MAX_ATTEMPTS=3
GOVERNANCE_RECHECK_SECONDS=60
WORKER_TEMP_ROOT=./var/worker-tmp
# Independent durable ledger; never roll back with the business database or media snapshots.
DELETION_LEDGER_PATH=./var/governance/deletions.jsonl
MEDIA_JOB_MAX_ATTEMPTS=3
REPORT_JOB_MAX_ATTEMPTS=1
MAX_UPLOAD_BYTES=4294967296
MAX_ARTIFACT_BYTES=4294967296
UPLOAD_TIMEOUT_SECONDS=1800
MAX_MEDIA_DURATION_MS=7200000
MAX_VIDEO_HEIGHT=1080
KEYFRAME_INTERVAL_MS=30000
MAX_KEYFRAMES=240
ASR_MODEL_PATH=
ASR_MODEL_NAME=
ASR_MODEL_REVISION=
WORKER_PROCESSOR_VERSION=
FFMPEG_BUILD_SHA256=
ASR_DEVICE=cpu
REPORT_API_BASE=
REPORT_API_KEY=
REPORT_MODEL=
REPORT_MODEL_REVISION=
REPORT_PROMPT_VERSION=p0-v1
REPORT_PROMPT_SHA256=
REPORT_SELECTION_VERSION=time-window-v1
REPORT_TIMEOUT_SECONDS=90
REPORT_MAX_INPUT_TOKENS=8000
REPORT_MAX_OUTPUT_TOKENS=3000
MODEL_BUDGET_CURRENCY=CNY
MODEL_BUDGET_TIMEZONE=Asia/Shanghai
MODEL_MONTHLY_BUDGET=0
MODEL_PRICE_VERSION=
MODEL_INPUT_PRICE_PER_MILLION=0
MODEL_OUTPUT_PRICE_PER_MILLION=0
MEDIA_RETENTION_DAYS=14
CONTENT_RETENTION_DAYS=180
EXPORT_RETENTION_HOURS=24
BACKUP_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=180

# One-time administrator bootstrap. Set the password only in the local environment,
# run the bootstrap command, then remove it from the environment.
BOOTSTRAP_SCHOOL_CODE=SCHOOL
BOOTSTRAP_SCHOOL_NAME=示例学校
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_COLLEGE_CODE=SOFTWARE
BOOTSTRAP_COLLEGE_NAME=软件学院
BOOTSTRAP_ACADEMIC_USERNAME=academic_demo
BOOTSTRAP_ACADEMIC_DISPLAY_NAME=教务管理员示例
BOOTSTRAP_SUPERVISOR_USERNAME=supervisor_demo
BOOTSTRAP_SUPERVISOR_DISPLAY_NAME=教学督导示例
BOOTSTRAP_TEACHER_USERNAME=teacher_demo
BOOTSTRAP_TEACHER_DISPLAY_NAME=任课教师示例
BOOTSTRAP_TEST_PASSWORD=
