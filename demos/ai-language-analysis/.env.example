DASHSCOPE_API_KEY=
# 公共兼容接口；如果百炼控制台明确要求专属部署地址，再替换为平台提供的地址
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_ASR_MODEL=qwen3-asr-flash
# 中英混讲课堂建议保留 zh,en；单语音频可改成单个代码
BAILIAN_ASR_LANGUAGE_HINTS=zh,en
BAILIAN_TEXT_MODEL=qwen-plus
# 默认1：生成后增加1次文本模型全文复核；0明确跳过，不会显示为已复核
BAILIAN_REPORT_AUDIT=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
DEMO_PORT=8090

# Demo binds to localhost by default; keep a single process per data directory.
DEMO_HOST=127.0.0.1
DEMO_DATA_DIR=data
